{
  "manifest_version": 3,
  "name": "YouTube 中文字幕",
  "version": "0.1.0",
  "description": "自动获取或识别 YouTube 视频字幕并翻译成中文，叠加显示在播放器上（需配合本地后端服务使用）",
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://www.youtube.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube 中文字幕"
  }
}
